{
  "opencollection": "1.0.0",
  "info": {
    "name": "PDCP Asset vuln API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "vuln",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get scan log stats of given scan id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.projectdiscovery.io/v1/scans/vulns/history",
            "params": [
              {
                "name": "vuln_hash",
                "value": "",
                "type": "query"
              },
              {
                "name": "history_limit",
                "value": "",
                "type": "query",
                "description": "Specifies the maximum number of revisions to be returned."
              }
            ]
          },
          "docs": "Get scan log stats of given scan id"
        }
      ]
    }
  ],
  "bundled": true
}