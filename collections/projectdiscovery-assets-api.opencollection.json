{
  "opencollection": "1.0.0",
  "info": {
    "name": "PDCP Asset assets API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "assets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Asset Changelogs for a given asset_id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.projectdiscovery.io/v1/asset/:asset_id/changelogs",
            "headers": [
              {
                "name": "X-Team-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "asset_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "time",
                "value": "",
                "type": "query",
                "description": "time filter to select"
              },
              {
                "name": "event_type",
                "value": "",
                "type": "query",
                "description": "comma separated event_type e.g. event_type=vul_status,vul_status_change"
              },
              {
                "name": "sort_asc",
                "value": "",
                "type": "query",
                "description": "comma separated ascending sorting e.g sort_asc=created_at,severity"
              },
              {
                "name": "sort_desc",
                "value": "",
                "type": "query",
                "description": "comma separated descending sorting e.g sort_desc=created_at,severity"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "number of results to get"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "number of results to skip"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get asset changelogs"
        },
        {
          "info": {
            "name": "Update Asset Labels",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.projectdiscovery.io/v1/asset/labels",
            "headers": [
              {
                "name": "X-Team-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "update_type",
                "value": "",
                "type": "query",
                "description": "Append or Replace update_type"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Asset Labels"
        },
        {
          "info": {
            "name": "Add labels to an asset",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.projectdiscovery.io/v1/asset/:asset_id/labels",
            "headers": [
              {
                "name": "X-Team-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "asset_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add labels to an asset"
        },
        {
          "info": {
            "name": "Modify labels of an asset",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.projectdiscovery.io/v1/asset/:asset_id/labels",
            "params": [
              {
                "name": "asset_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "update_type",
                "value": "",
                "type": "query",
                "description": "Append or Replace update_type"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Modify labels of an asset"
        },
        {
          "info": {
            "name": "Delete labels of an asset",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.projectdiscovery.io/v1/asset/:asset_id/labels",
            "headers": [
              {
                "name": "X-Team-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "asset_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete labels of an asset"
        }
      ]
    }
  ],
  "bundled": true
}