{
  "opencollection": "1.0.0",
  "info": {
    "name": "PDCP Asset retests API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "retests",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Retest Vulnerability",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.projectdiscovery.io/v1/retest/:vuln_id",
            "headers": [
              {
                "name": "X-Team-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "vuln_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get retest vulnerability (retests from editor)"
        }
      ]
    }
  ],
  "bundled": true
}