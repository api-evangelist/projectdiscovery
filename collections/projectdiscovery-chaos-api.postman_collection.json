          "name": "Get Associated Domains",
          "request": {
            "name": "Get Associated Domains",
            "description": {
              "content": "Discover domains related to a given domain through acquisition history, certificate transparency logs, and WHOIS records. Returns associated domains with evidence of their relationship.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "domain",
                "associated"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "domain",
                  "value": "<string>",
                  "description": "Domain name to fetch associated domains. If omitted, returns associated domains for all your verified domains."
                },
                {
                  "disabled": false,
                  "key": "source",
                  "value": "<string>",
                  "description": "Comma-separated source filter (acquisition_history, certificate_history, whois_history)"
                },
                {
                  "disabled": false,
                  "key": "active",
                  "value": "<boolean>",
                  "description": "Filter by liveness (true=alive, false=unreachable)"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Sort results"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum results per page (pagination). If omitted, returns all."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Page number (pagination, starts at 1)"
                },
                {
                  "disabled": false,
                  "key": "raw",
                  "value": "<boolean>",
                  "description": "If true, returns plain text list (one domain per line)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "key": "X-Team-Id",
                "value": "<string>",
                "description": ""
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
